# Copy to .env and adjust. Every value also has a CLI flag that overrides it
# (see `ibkr --help`).

# ── IBKR gateway client ─────────────────────────────────────────────────
# Base URL of the gateway. Inside the devcontainer compose stack the gateway
# runs as the `ibkr-gateway` service; on the host use https://127.0.0.1:8080.
IBKR_GATEWAY_URL=https://ibkr-gateway:8080

# Bearer token accepted by the gateway (its GATEWAY_API_TOKENS value).
IBKR_GATEWAY_TOKEN=dev-token-change-me

# Mutual-TLS material. Generated by scripts/gen-dev-certs.sh; the client
# presents client.pem/client-key.pem and trusts ca.pem.
IBKR_GATEWAY_CA_CERT=.certs/ca.pem
IBKR_GATEWAY_CLIENT_CERT=.certs/client.pem
IBKR_GATEWAY_CLIENT_KEY=.certs/client-key.pem

# Alternative: point at the live gateway's client bundle instead of the local
# compose stack's dev certs (git-ignored — never commit these keys).
# IBKR_GATEWAY_CA_CERT=tmp/ibkr-rs-client/ca.pem
# IBKR_GATEWAY_CLIENT_CERT=tmp/ibkr-rs-client/ibkr.rs.pem
# IBKR_GATEWAY_CLIENT_KEY=tmp/ibkr-rs-client/ibkr.rs-key.pem

# Request timeout in seconds.
IBKR_GATEWAY_TIMEOUT_SEC=60

# Retries for rate-limited reads (429); 0 disables. Mutations are never
# retried, regardless of this value.
IBKR_GATEWAY_MAX_RETRIES=3

# Local trade store used by `ibkr store` (default: ./ibkr.db).
# IBKR_STORE_DB=ibkr.db

# Development only: accept invalid/self-signed server certificates.
# IBKR_GATEWAY_TLS_SKIP_VERIFY=false

# ── Gateway service (docker compose profile `gateway`) ──────────────────
# Token the gateway itself accepts. Keep in sync with IBKR_GATEWAY_TOKEN.
GATEWAY_API_TOKENS=dev-token-change-me
