/target

# Credentials and key material — never tracked.
/.certs
/.env
/.env.*
!.env.example
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
# Live-gateway client bundle for this machine (ca.pem + client cert + key).
/tmp
# Private keys anywhere: the cert half is fine to commit, the key half is not.
*-key.pem
*.key

# Local trade store created by `ibkr store` (default --db location).
/ibkr.db
/ibkr.db-wal
/ibkr.db-shm

# Local tool/editor state
.idea/
.DS_Store
*.swp
