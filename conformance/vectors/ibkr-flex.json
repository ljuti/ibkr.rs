      "raw": {
        "accountId": "U1234567",
        "trades": [
          {
            "transactionId": "o1",
            "conid": "864356869",
            "symbol": "AEM 260918C00205000",
            "assetCategory": "OPT",
            "currency": "USD",
            "tradeDate": "2026-08-28",
            "buySell": "BUY",
