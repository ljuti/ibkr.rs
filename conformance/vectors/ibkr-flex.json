            "price": 20.5,
            "cost": 2050.0,
            "commission": -1.0,
            "fifoPnlRealized": 0.0,
            "multiplier": 100.0,
            "strike": 205.0,
            "expiry": "2026-09-18",
            "putCall": "C",
            "levelOfDetail": "EXECUTION"
          },
          {
            "transactionId": "c1",
            "conid": "864356869",
            "symbol": "AEM 260918C00205000",
            "assetCategory": "OPT",
            "currency": "USD",
            "tradeDate": "2026-09-18",
            "buySell": "SELL",
            "openClose": "C",
            "quantity": -10.0,
            "price": 0.0,
            "cost": 2050.0,
            "commission": 0.0,
            "fifoPnlRealized": -2050.0,
            "multiplier": 100.0,
            "strike": 205.0,
            "expiry": "2026-09-18",
            "putCall": "C",
            "levelOfDetail": "EXECUTION"
          }
        ],
        "lots": [],
        "cashTransactions": []
      },
      "expect": {
        "ingest": {
          "executions": 2,
          "lots": 0,
          "cashTransactions": 0,
          "skipped": 0,
          "cashDated": 0
        },
        "queries": [
          { "sql": "SELECT COUNT(*) FROM executions WHERE price = 0", "rows": [[1]] },
          {
            "sql": "SELECT ROUND(SUM(realized_pnl), 2) FROM executions WHERE open_close = 'C'",
            "rows": [[-2050.0]]
          },
          {
            "sql": "SELECT strike, put_call, expiry FROM executions WHERE transaction_id = 'c1'",
            "rows": [[205.0, "C", "2026-09-18"]]
          }
        ]
      }
    },

    {
      "name": "overlapping-reports-converge",
      "why": "Report windows overlap (a 30-day window sits inside a yearly one), so the same execution and the same lot arrive twice. Rows are keyed by IB transaction id (executions) and by lot content plus ordinal (lots), so the second report adds only what the first did not have.",
      "report": "wide-window",
      "raw": {
        "accountId": "U1234567",
        "trades": [
          {
            "transactionId": "shared-exec",
            "conid": "265598",
            "symbol": "AAPL",
            "assetCategory": "STK",
            "currency": "USD",
            "tradeDate": "2026-08-28",
            "buySell": "SELL",
            "openClose": "C",
            "quantity": -10.0,
            "price": 215.5,
            "fifoPnlRealized": 50.0,
            "levelOfDetail": "EXECUTION"
          }
        ],
        "lots": [
          {
            "transactionId": "shared-open",
            "conid": "265598",
            "symbol": "AAPL",
            "assetCategory": "STK",
            "currency": "USD",
            "tradeDate": "2026-08-28",
            "tradeTime": "20260828;123310",
            "buySell": "SELL",
            "openClose": "C",
            "quantity": 10.0,
            "cost": 2105.0,
            "fifoPnlRealized": 50.0,
            "multiplier": 1.0,
            "openDateTime": "20260302;100000",
            "levelOfDetail": "CLOSED_LOT"
          }
        ],
        "cashTransactions": []
      },
      "expect": {
        "ingest": {
          "executions": 1,
          "lots": 1,
          "cashTransactions": 0,
          "skipped": 0,
          "cashDated": 0
        },
        "extraSyncs": [
          {
            "report": "narrow-window",
            "raw": {
              "accountId": "U1234567",
              "trades": [
                {
                  "transactionId": "shared-exec",
                  "conid": "265598",
                  "symbol": "AAPL",
                  "assetCategory": "STK",
                  "currency": "USD",
                  "tradeDate": "2026-08-28",
                  "buySell": "SELL",
                  "openClose": "C",
                  "quantity": -10.0,
                  "price": 215.5,
                  "fifoPnlRealized": 50.0,
                  "levelOfDetail": "EXECUTION"
                },
                {
                  "transactionId": "newer-exec",
                  "conid": "265598",
                  "symbol": "AAPL",
                  "assetCategory": "STK",
                  "currency": "USD",
                  "tradeDate": "2026-09-04",
                  "buySell": "BUY",
                  "openClose": "O",
                  "quantity": 5.0,
                  "price": 220.0,
                  "fifoPnlRealized": 0.0,
                  "levelOfDetail": "EXECUTION"
                }
              ],
              "lots": [
                {
                  "transactionId": "shared-open",
                  "conid": "265598",
                  "symbol": "AAPL",
                  "assetCategory": "STK",
                  "currency": "USD",
                  "tradeDate": "2026-08-28",
                  "tradeTime": "20260828;123310",
                  "buySell": "SELL",
                  "openClose": "C",
                  "quantity": 10.0,
                  "cost": 2105.0,
                  "fifoPnlRealized": 50.0,
                  "multiplier": 1.0,
                  "openDateTime": "20260302;100000",
                  "levelOfDetail": "CLOSED_LOT"
                }
              ],
              "cashTransactions": []
            }
          }
        ],
        "queries": [
          { "sql": "SELECT COUNT(*) FROM executions", "rows": [[2]] },
          { "sql": "SELECT COUNT(*) FROM round_trips", "rows": [[1]] },
          { "sql": "SELECT COUNT(*) FROM sync_state", "rows": [[2]] }
        ]
      }
    }
